# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- sakthi PostgreSQL (LAN, ShaktiDB 18.4 / pgvector 0.8.2): primary serving database ---
SAKTHI_DB_HOST=192.168.200.29
SAKTHI_DB_PORT=11233
SAKTHI_DB_NAME=ipc_db
SAKTHI_DB_USER=ipc_user
SAKTHI_DB_PASSWORD=
# The server has ssl=off; "disable" is an explicit LAN-only choice. Use require once TLS is enabled.
SAKTHI_DB_SSLMODE=disable

# Self-hosted EmbeddingGemma (OpenAI-compatible /v1/embeddings)
GEMMA_EMBEDDING_API_BASE=
GEMMA_EMBEDDING_API_KEY=
GEMMA_EMBEDDING_MODEL=embeddinggemma-2

# Optional constrained LLM (OpenAI-compatible /v1/chat/completions). Disabled unless LLM_ENABLED=true.
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# Local docker pgvector (infra/docker-compose.yml) for tests/measurement
LOCAL_DATABASE_URL=postgresql://ipc:ipc_local_only@localhost:5433/ipc
# sakthi (default) | local
IPC_DB_TARGET=sakthi

# --- Models ---------------------------------------------------------------
# bge_m3 (served index, local) | gemma_api (comparison only)
EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
RERANKER_MODEL_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
# cuda | cpu | auto. "auto" falls back to CPU fp32 (several GB more RAM) if CUDA cannot initialise.
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# --- Optional LLM (OFF by default; sends document text to LLM_API_BASE when on) ---
LLM_ENABLED=false

# --- Retention: nothing submitted is stored unless explicitly enabled ----
STORE_INPUT_DOCUMENTS=false
STORE_ABSTRACTS=false

# --- Admin API (disabled when unset) --------------------------------------
ADMIN_TOKEN=

# --- Frontend (apps/web, server-side only) ---------------------------------
IPC_API_BASE_URL=http://127.0.0.1:8000
